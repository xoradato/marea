# Copy to .env and fill in the key from the AMD Token Factory dashboard.
# Never commit .env. On Streamlit Cloud, put the same keys in App settings -> Secrets.
AMD_API_BASE=https://developer.amd.com.cn/radeon/api/v1
AMD_API_KEY=
AMD_MODEL=Gemma-4-31B-IT
# Optional: tried once when the main model takes over 15 s or is saturated. Empty turns it off.
AMD_MODEL_FALLBACK=DeepSeek-V4-Flash
